  m_Script: {fileID: 11500000, guid: 4a1171847eb875841a989d214a1e802a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialougeTrigger
  dialouge:
    names:
    - ...
    - ...
    - ...
    - ...
    sentences:
    - 'Soon, a soul from the once living will join you. From that coffin, they will
      stand before you behind the podium. You are to listen to their grievances and
      learn of their story, reasons, and decisions, in order to cast your verdict. '
    - "Justice and Judgement will speak their mind to you which will aid your considerations
      for the soul\u2019s final verdict. You get to choose who\u2019s opinion you
      believe is best and send the soul off to their destination in the divine realm."
    - Remember to listen closely. All words are exchanged only once and all mistakes
      are never in your favor.
    - 'It would be a shame to see you gone so soon, newly appointed. '
